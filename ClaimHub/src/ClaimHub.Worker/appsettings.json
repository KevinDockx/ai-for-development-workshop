{
  "ConnectionStrings": {
    "ClaimHub": "Data Source=data/claimhub.db"
  },
  "DocumentStorage": {
    "RootPath": "data/documents"
  },
  "Jobs": {
    "Billing": {
      "Enabled": true,
      "InitialDelay": "00:05:00",
      "Interval": "1.00:00:00",
      "RunOnce": false,
      "LookaheadDays": 30,
      "MaxPoliciesPerRun": 1000
    },
    "Dunning": {
      "Enabled": true,
      "InitialDelay": "00:10:00",
      "Interval": "06:00:00",
      "RunOnce": false,
      "ReminderAfterDays": 15,
      "SuspensionAfterDays": 45,
      "MaxInvoicesPerRun": 500
    },
    "ClaimSla": {
      "Enabled": true,
      "InitialDelay": "00:02:00",
      "Interval": "00:30:00",
      "RunOnce": false,
      "EscalationAfterDays": 5
    },
    "Renewal": {
      "Enabled": true,
      "InitialDelay": "00:15:00",
      "Interval": "12:00:00",
      "RunOnce": false,
      "RenewalWindowDays": 45,
      "MaxRenewalsPerRun": 25,
      "RunAsUser": "worker@scheldt.example"
    },
    "NightlyExport": {
      "Enabled": true,
      "InitialDelay": "00:20:00",
      "Interval": "1.00:00:00",
      "RunOnce": false,
      "ExportFolder": "exports",
      "FilePrefix": "claimhub-export"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
