@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="alert alert-warning mt-4">
    <h1 class="h4">Access denied</h1>
    <p class="mb-2">Your account (@User.Identity?.Name) is not allowed to open this page. The back office is limited to Scheldt Assurance staff roles.</p>
    <a class="btn btn-outline-secondary btn-sm" asp-page="/Login">Sign in with a different account</a>
</div>
