@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Something went wrong</h1>
<p>The request could not be completed. Go back and try again, or return to the <a asp-page="/Dashboard">dashboard</a>.</p>

@if (Model.ShowRequestId)
{
    <p class="text-muted">
        Reference for support: <code>@Model.RequestId</code>
    </p>
}
